rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// This file is the source of truth; the console is just where it gets deployed.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's log, targets, overrides, weight and metadata.
    // Reachable only by that account — enforced here, on Google's servers, not in the browser.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The foods and recipes library, deliberately shared between both accounts.
    match /shared/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Strava daily calorie rollups, written only by the stravaWebhook Cloud Function (Admin
    // SDK, which bypasses these rules entirely). This is a flat top-level collection, not
    // nested under strava/ — doc paths must alternate collection/document, so strava/daily/
    // {date} would be an invalid (odd-segment) reference. strava/tokens stays denied by
    // default (not matched by any rule) — only this one read is opened up for the app.
    match /stravaDaily/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
